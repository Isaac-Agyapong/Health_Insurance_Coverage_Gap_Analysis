    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Words used here",
                    "textStyle": {
                      "fontSize": "19pt",
                      "color": "#0E9F6E",
                      "fontWeight": "bold",
                      "fontFamily": "Bahnschrift"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Low-income adults: people aged 18-64 earning about $20,000 a year or less for one person (138% of the federal poverty line, the Medicaid expansion limit)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Uninsured: has no health insurance of any kind",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Medicaid expansion: a state lets these adults get Medicaid; 40 states and DC have done it since 2014",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  \"16 in 100\": out of every 100 low-income adults, 16 have no health insurance",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  States that did not expand: the 12 states that had not expanded Medicaid by the end of 2023",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
