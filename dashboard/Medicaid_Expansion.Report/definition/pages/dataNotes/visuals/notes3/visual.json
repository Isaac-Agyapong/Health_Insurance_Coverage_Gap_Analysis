  "name": "notes3",
  "visual": {
    "visualType": "textbox",
    "drillFilterOtherVisuals": true,
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limitations",
                    "textStyle": {
                      "fontSize": "19pt",
                      "color": "#1B1B1B",
                      "fontWeight": "bold",
                      "fontFamily": "Georgia"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  SAHIE figures are model-based estimates with margins of error (median about 4 points per county)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  DE, DC, MA, NY and VT are excluded from the effect estimate: they covered adults before 2014",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Connecticut counties changed in 2022, so Connecticut is left out of county-level results",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  States chose whether to expand; a state-specific change at the same time would bias the estimate",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Predictions assume expansion would work as it did in similar counties; they are not enrollment forecasts",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
