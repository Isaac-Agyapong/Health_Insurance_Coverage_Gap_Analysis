    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Keep in mind",
                    "textStyle": {
                      "fontSize": "19pt",
                      "color": "#D63F6C",
                      "fontWeight": "bold",
                      "fontFamily": "Bahnschrift"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Census figures are estimates with a margin of error (about 4 in 100 for a typical county)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Five states that already covered these adults before 2014 (DE, DC, MA, NY, VT) are left out of the effect",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Connecticut changed its county system in 2022, so it is left out of county results",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  States chose whether to expand; something else changing at the same time could affect the estimate",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Predictions assume expansion would work as it did in similar places; they are not enrollment forecasts",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
