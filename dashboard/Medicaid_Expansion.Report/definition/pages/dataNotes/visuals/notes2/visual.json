              {
                "textRuns": [
                  {
                    "value": "\u2022  Low-income adults = ages 18-64 with income at or below 138% of the federal poverty level",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Expansion year = first calendar year with at least 6 months of expansion coverage",
