    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Where the data comes from",
                    "textStyle": {
                      "fontSize": "19pt",
                      "color": "#1F2D3D",
                      "fontWeight": "bold",
                      "fontFamily": "Bahnschrift"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  US Census Bureau Small Area Health Insurance Estimates (SAHIE), 2008-2023, every county",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  KFF tracker of when each state expanded Medicaid",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Census poverty, income and population figures; USDA rural-urban codes",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Loaded into PostgreSQL and checked: county totals match state totals, and medians match the Census's published 2023 figures exactly",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  How much expansion itself caused, and predictions for the remaining states: see the companion machine learning project (Medicaid_Expansion_Impact_Model)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2D3D"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
