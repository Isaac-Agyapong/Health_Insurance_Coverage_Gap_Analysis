                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Rates are population-weighted: total uninsured / total people",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Effect: staggered difference-in-differences vs counties in states that had not expanded, adjusted for county traits; 95% intervals from 499 state-level bootstrap draws",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "\u2022  Predictions: causal forest (double machine learning) validated on held-out states",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1B1B"
                    }
                  }
                ]
