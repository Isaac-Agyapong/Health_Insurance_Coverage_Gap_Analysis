table state_year
	lineageTag: 5cdfd694-39ea-59a7-b978-9979edd0b9ea

	measure 'State Rate' = DIVIDE ( SUM ( state_year[uninsured] ), SUM ( state_year[population] ) )
		formatString: 0%
		displayFolder: States
		lineageTag: 887e6e54-0f2c-5c7c-87f3-c481946945fa

	measure 'State Rate 2023' = CALCULATE ( [State Rate], state_year[year] = 2023 )
		formatString: 0.0%
		displayFolder: States
		lineageTag: 81a10e50-0b2c-527d-ac95-3c3f3fef0371

	measure 'State Rate 2013' = CALCULATE ( [State Rate], state_year[year] = 2013 )
		formatString: 0.0%
		displayFolder: States
		lineageTag: 6a0b9278-4eb4-5c4b-b826-95b8349287de

	measure 'State Change' = ( [State Rate 2023] - [State Rate 2013] ) * 100
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: States
		lineageTag: 55074c90-b784-56d9-922b-8b4dd918fd06

	measure 'Top 10 Uninsured 2023' =
			// ranks every state, whatever is clicked on the map (REMOVEFILTERS, not ALLSELECTED)
			VAR _cur = [State Rate 2023]
			VAR _all = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( state_year[state_name] ), "@r", [State Rate 2023] ),
			    REMOVEFILTERS ( state_year ), REMOVEFILTERS ( StateGrid ) )
			RETURN IF ( NOT ISBLANK ( _cur ) && COUNTROWS ( FILTER ( _all, [@r] > _cur ) ) < 10, _cur )
		formatString: 0%
		displayFolder: States
		lineageTag: da7bcdf4-605e-577c-95db-583d5a0b086a

	measure 'Top 10 Drop' =
			VAR _cur = [State Change]
			VAR _all = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( state_year[state_name] ), "@c", [State Change] ),
			    REMOVEFILTERS ( state_year ), REMOVEFILTERS ( StateGrid ) )
			RETURN IF ( NOT ISBLANK ( _cur ) && COUNTROWS ( FILTER ( _all, [@c] < _cur ) ) < 5, _cur )
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: States
		lineageTag: 3bb8604f-c2e5-5c52-8e7c-e2ff8d596f79

	measure 'Top 10 Drop 2013' = IF ( NOT ISBLANK ( [Top 10 Drop] ), [State Rate 2013] )
		formatString: 0%
		displayFolder: States
		lineageTag: af887aaf-9ae3-5cdb-a2b9-244f54035c60

	measure 'Top 10 Drop 2023' = IF ( NOT ISBLANK ( [Top 10 Drop] ), [State Rate 2023] )
		formatString: 0%
		displayFolder: States
		lineageTag: 18e84ca3-ca04-5bf2-8f4d-40c0700b34a2

	measure 'Status Colour' =
			SWITCH ( SELECTEDVALUE ( state_year[analysis_group] ),
			    "Not expanded by 2023", "#D63F6C",
			    "Excluded (early coverage)", "#CDD3DA",
			    "#0E9F6E" )
		displayFolder: States
		lineageTag: 6a0ed853-eb3f-51dd-a635-faa42563efb5

	measure 'Tile Label' = SELECTEDVALUE ( StateGrid[state_abbr] )
		displayFolder: Map
		lineageTag: 89d8f190-b931-5bc7-bea1-831f934f7240

	measure 'Rate Colour' =
			VAR _r = [State Rate 2023]
			RETURN SWITCH ( TRUE (),
			    ISBLANK ( SELECTEDVALUE ( StateGrid[state_abbr] ) ), "#FFFFFF",
			    ISBLANK ( _r ), "#E6EAE4",
			    _r < 0.12, "#EEEAF7",
			    _r < 0.16, "#D2C8EE",
			    _r < 0.20, "#A999DD",
			    _r < 0.25, "#7E6CC7",
			    _r < 0.30, "#5A48A8",
			    "#3B2B7A" )
		displayFolder: Map
		lineageTag: 69b59007-c77a-5e92-8c18-669a367652d2

	measure 'Label Colour' = IF ( [State Rate 2023] >= 0.20, "#FFFFFF", "#1F2D3D" )
		displayFolder: Map
		lineageTag: 83c30007-bb30-5ae5-ba04-2d1c5b3dc0ff

	measure 'Border Colour' = "#F5F6F1"
		displayFolder: Map
		lineageTag: a6771a6e-cec0-5f5f-98fb-8e8302cad62b

	measure 'Selected State' = SELECTEDVALUE ( state_year[state_name], "All states" )
		displayFolder: Tooltip
		lineageTag: fa3cc5e1-4159-5745-935f-cc0ab5ccc5f3

	measure 'Status Text' =
			VAR _g = SELECTEDVALUE ( state_year[analysis_group] )
			VAR _y = SELECTEDVALUE ( state_year[expansion_year] )
			RETURN SWITCH ( TRUE (),
			    _g = "Excluded (early coverage)", "Covered low-income adults before 2014",
			    _g = "Not expanded by 2023" && ISBLANK ( _y ), "Has not expanded Medicaid",
			    _g = "Not expanded by 2023", "Expanded in late 2023",
			    "Expansion in effect from " & _y )
		displayFolder: Tooltip
		lineageTag: b3871eb1-2f1f-5f41-a417-787b5b444e95

	measure 'Rank Text' =
			VAR _cur = [State Rate 2023]
			VAR _all = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( state_year[state_name] ), "@r", [State Rate 2023] ),
			    REMOVEFILTERS ( state_year ), REMOVEFILTERS ( StateGrid ) )
			RETURN IF ( HASONEVALUE ( state_year[state_name] ), "#" & COUNTROWS ( FILTER ( _all, [@r] > _cur ) ) + 1 & " of 51 for uninsured rate (2023)" )
		displayFolder: Tooltip
		lineageTag: 359fa53b-ff70-5cd4-89d0-e9eb49536459

	column state_abbrev
