		summarizeBy: none
		sourceColumn: analysis_group

		annotation SummarizationSetBy = Automatic

	column expansion_year
		dataType: int64
		formatString: 0
		lineageTag: 3482f211-6a4b-5ba0-b7af-414a235136c5
		summarizeBy: none
		sourceColumn: expansion_year

		annotation SummarizationSetBy = Automatic

	column in_study
		dataType: boolean
		isHidden
		lineageTag: 9b331021-f615-53f1-9405-2cff6cd409f2
		summarizeBy: none
		sourceColumn: in_study

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 328822ab-f1c2-5ece-9e09-ae8066b634bb
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column uninsured
		dataType: int64
		formatString: 0
		lineageTag: 9a917b99-0568-5460-9f70-7fa83ab7eef6
		summarizeBy: sum
		sourceColumn: uninsured

		annotation SummarizationSetBy = Automatic

	column population
		dataType: int64
		formatString: 0
		lineageTag: 27a47a2e-7870-513c-9b5a-0e3cc9b860c8
		summarizeBy: sum
		sourceColumn: population

		annotation SummarizationSetBy = Automatic

	column pct_uninsured
		dataType: double
		formatString: #,0.00
		lineageTag: 20e53654-68dc-5212-9452-f12ecf7ec03d
		summarizeBy: sum
		sourceColumn: pct_uninsured

		annotation SummarizationSetBy = Automatic

	partition state_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "state_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"state_abbrev", type text}, {"state_name", type text}, {"analysis_group", type text}, {"expansion_year", Int64.Type}, {"in_study", type logical}, {"year", Int64.Type}, {"uninsured", Int64.Type}, {"population", Int64.Type}, {"pct_uninsured", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
