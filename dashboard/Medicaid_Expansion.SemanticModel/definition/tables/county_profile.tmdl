	partition county_profile = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "county_profile.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"county_fips", Int64.Type}, {"county_name", type text}, {"state_abbrev", type text}, {"state_name", type text}, {"county_label", type text}, {"medicaid_status", type text}, {"rurality", type text}, {"uninsured_2023", Int64.Type}, {"low_income_adults_2023", Int64.Type}, {"rate_2023", type number}, {"rate_2013", type number}, {"state_rate_2023", type number}, {"us_rate_2023", type number}, {"adults_gaining_coverage", type number}, {"predicted_rate_after", type number}, {"rank_us", Int64.Type}, {"counties_ranked", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
