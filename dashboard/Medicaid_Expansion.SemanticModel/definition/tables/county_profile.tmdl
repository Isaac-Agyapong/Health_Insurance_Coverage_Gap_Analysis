table county_profile
	lineageTag: 6ddb423d-77ef-518e-a411-d67d1deb6082

	measure 'Profile Name' = IF ( HASONEVALUE ( county_profile[county_label] ), SELECTEDVALUE ( county_profile[county_label] ), "Pick a county" )
		displayFolder: County
		lineageTag: 410fc7aa-b867-5111-8c3d-7d2788525ab7

	measure 'Profile Status' = IF ( HASONEVALUE ( county_profile[county_label] ), SELECTEDVALUE ( county_profile[medicaid_status] ) & "   ·   " & SELECTEDVALUE ( county_profile[rurality] ) & "   ·   #" & FORMAT ( SUM ( county_profile[rank_us] ), "#,0" ) & " of " & FORMAT ( MAX ( county_profile[counties_ranked] ), "#,0" ) & " counties for share uninsured", "Type a county name in the search box" )
		displayFolder: County
		lineageTag: 4b1c339d-78cd-5e10-b9cf-c1ff35f63eb4

	measure 'Profile Uninsured' = IF ( HASONEVALUE ( county_profile[county_label] ), SUM ( county_profile[uninsured_2023] ) )
		formatString: #,0
		displayFolder: County
		lineageTag: 3b71fb75-f6b2-59cd-aa8b-9f572528f846

	measure 'Profile Adults Context' = IF ( HASONEVALUE ( county_profile[county_label] ), "out of " & FORMAT ( SUM ( county_profile[low_income_adults_2023] ), "#,0" ) & " low-income adults" )
		displayFolder: County
		lineageTag: b9ba7e98-6760-50e3-be6c-7a9acdada7ad

	measure 'Profile Rate' = IF ( HASONEVALUE ( county_profile[county_label] ), SUM ( county_profile[rate_2023] ) / 100 )
		formatString: 0%
		displayFolder: County
		lineageTag: e0aed6c8-441b-50d0-9a3a-24259069ac38

	measure 'Profile Rate Context' = IF ( HASONEVALUE ( county_profile[county_label] ), "state average " & FORMAT ( SUM ( county_profile[state_rate_2023] ) / 100, "0%" ) & "   ·   US " & FORMAT ( MAX ( county_profile[us_rate_2023] ) / 100, "0%" ) )
		displayFolder: County
		lineageTag: 1a2f37fe-4287-57f0-a458-3e24a6c1198f

	measure 'Profile Change' =
			VAR _d = SUM ( county_profile[rate_2013] ) - SUM ( county_profile[rate_2023] )
			RETURN IF ( HASONEVALUE ( county_profile[county_label] ) && NOT ISBLANK ( SUM ( county_profile[rate_2013] ) ), FORMAT ( ABS ( _d ), "0" ) & IF ( _d >= 0, " fewer", " more" ) )
		displayFolder: County
		lineageTag: fd046812-85cc-5e8c-ac5b-bde998780f2f

	measure 'Profile Change Context' = IF ( HASONEVALUE ( county_profile[county_label] ), "share uninsured was " & FORMAT ( SUM ( county_profile[rate_2013] ) / 100, "0%" ) & " in 2013" )
		displayFolder: County
		lineageTag: c7fd34d7-b9fd-5e98-be59-2cdab3fed8d9

	measure 'Profile Gain' = IF ( HASONEVALUE ( county_profile[county_label] ), IF ( ISBLANK ( SUM ( county_profile[adults_gaining_coverage] ) ), "Already expanded", FORMAT ( SUM ( county_profile[adults_gaining_coverage] ), "#,0" ) ) )
		displayFolder: County
		lineageTag: 0665a08b-09ec-5f5f-9395-edb3412987e4

	measure 'Profile Gain Context' = IF ( HASONEVALUE ( county_profile[county_label] ), IF ( ISBLANK ( SUM ( county_profile[adults_gaining_coverage] ) ), "this state already expanded Medicaid", "uninsured would fall to about " & FORMAT ( SUM ( county_profile[predicted_rate_after] ) / 100, "0%" ) ) )
		displayFolder: County
		lineageTag: 19db19d1-e613-523c-9442-6b5d62783627

	measure 'Compare Rate' =
			SWITCH ( SELECTEDVALUE ( Compare[order] ),
			    1, [Profile Rate],
			    2, IF ( HASONEVALUE ( county_profile[county_label] ), SUM ( county_profile[state_rate_2023] ) / 100 ),
			    3, MAX ( county_profile[us_rate_2023] ) / 100 )
		formatString: 0%
		displayFolder: County
		lineageTag: 1055e968-ca4a-5ca3-9ce7-c9fbb92cc66c

	measure 'Compare Colour' = IF ( SELECTEDVALUE ( Compare[order] ) = 1, "#F5B700", "#B8C0C9" )
		displayFolder: County
		lineageTag: 369ae6e4-f98a-5458-8ef8-86679692ee15

	measure 'Profile Sentence' =
			VAR _n = SELECTEDVALUE ( county_profile[county_name] )
			VAR _st = SELECTEDVALUE ( county_profile[state_name] )
			VAR _r = SUM ( county_profile[rate_2023] )
			VAR _s = SUM ( county_profile[state_rate_2023] )
			VAR _g = SUM ( county_profile[adults_gaining_coverage] )
			RETURN IF ( HASONEVALUE ( county_profile[county_label] ),
			    "About " & FORMAT ( ROUND ( SUM ( county_profile[uninsured_2023] ), -2 ), "#,0" ) & " low-income adults in " & _n
			        & " have no health insurance: " & FORMAT ( _r, "0" ) & " in every 100. That is "
			        & IF ( _r > _s + 0.5, "higher than", IF ( _r < _s - 0.5, "lower than", "about the same as" ) )
			        & " the " & _st & " average (" & FORMAT ( _s, "0" ) & " in 100)."
			        & IF ( NOT ISBLANK ( _g ), " If " & _st & " expanded Medicaid, about " & FORMAT ( ROUND ( _g, -2 ), "#,0" )
			        & " more adults here would be insured.", "" ),
			    "Pick a county in the search box to see what its numbers mean." )
		displayFolder: County
		lineageTag: 5a6de0c6-72d4-55a7-b049-34530e9eb459

