	partition ml_county_predictions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ml_county_predictions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"county_fips", Int64.Type}, {"county_name", type text}, {"state", type text}, {"rurality", type text}, {"base_rate", type number}, {"predicted_effect_pts", type number}, {"effect_lo", type number}, {"effect_hi", type number}, {"predicted_rate_after", type number}, {"low_income_adults_2023", type number}, {"uninsured_2023", type number}, {"adults_gaining_coverage", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
