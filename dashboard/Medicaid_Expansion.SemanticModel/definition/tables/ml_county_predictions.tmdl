table ml_county_predictions
	lineageTag: f5172f6d-462e-542a-94af-7a418e809af0

	measure 'Adults Gaining' = SUM ( ml_county_predictions[adults_gaining_coverage] )
		formatString: #,0
		displayFolder: ML
		lineageTag: 0dd60636-2c2d-5052-8ffd-98dcec92e929

	measure 'Predicted Drop' = SUM ( ml_county_predictions[predicted_effect_pts] )
