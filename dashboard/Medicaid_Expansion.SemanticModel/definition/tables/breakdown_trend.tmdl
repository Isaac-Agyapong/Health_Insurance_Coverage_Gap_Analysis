table breakdown_trend
	lineageTag: 7808e087-f8b7-57a5-8126-7c8f32c2af3c

	measure 'Rate Expanded 2023' = CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[year] = 2023, breakdown_trend[analysis_group] = "Expanded 2014" ) / 100
		formatString: 0%
		displayFolder: Breakdown
		lineageTag: 5bf04aba-df99-5688-9726-8bdb86a8314c

	measure 'Rate Not Expanded 2023' = CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[year] = 2023, breakdown_trend[analysis_group] = "Not expanded by 2023" ) / 100
		formatString: 0%
		displayFolder: Breakdown
		lineageTag: b2e8b65f-c5e7-5fdd-90d0-9ef98e3b32cb

	measure 'Gap 2023' = ( [Rate Not Expanded 2023] - [Rate Expanded 2023] ) * 100
		formatString: 0
		displayFolder: Breakdown
		lineageTag: ef86b15d-576e-5c1b-a15b-21e9bd08bb23

	measure 'Gap Eligible' =
			CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[analysis_group] = "Not expanded by 2023", breakdown_trend[category] = "At or below 138% of poverty (eligible)" )
			- CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[analysis_group] = "Expanded 2014", breakdown_trend[category] = "At or below 138% of poverty (eligible)" )
		formatString: 0" pts"
		displayFolder: Breakdown
		lineageTag: 0aa05aa5-e1e2-5367-a80a-5ca677f8586f

	measure 'Gap Not Eligible' =
			CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[analysis_group] = "Not expanded by 2023", breakdown_trend[category] = "138-400% of poverty (not eligible)" )
			- CALCULATE ( AVERAGE ( breakdown_trend[pct_uninsured] ), breakdown_trend[analysis_group] = "Expanded 2014", breakdown_trend[category] = "138-400% of poverty (not eligible)" )
		formatString: 0" pts"
		displayFolder: Breakdown
		lineageTag: 938e9829-4144-525d-ab05-14b6c809f1c2

	column dimension
		dataType: string
		lineageTag: 6d411454-6caa-5e91-9533-24e99827840d
		summarizeBy: none
		sourceColumn: dimension

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: c2d17d43-e9a6-5169-9ac0-a51317ac806d
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

