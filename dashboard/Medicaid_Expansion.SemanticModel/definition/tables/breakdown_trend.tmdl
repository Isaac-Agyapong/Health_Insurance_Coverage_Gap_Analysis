		annotation SummarizationSetBy = Automatic

	partition breakdown_trend = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "breakdown_trend.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"dimension", type text}, {"category", type text}, {"analysis_group", type text}, {"year", Int64.Type}, {"pct_uninsured", type number}, {"row_label", type text}, {"row_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
