		dataType: string
		lineageTag: 37e1d0f3-c089-5e7a-b199-e96a4b0e45c9
		summarizeBy: none
		sourceColumn: analysis_group

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 15efd37e-6b38-5027-8303-ba544bc14371
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column pct_uninsured
		dataType: double
		formatString: #,0.00
		lineageTag: 58cba29b-8383-50a2-9680-7d841f3857b1
